// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`@godaddy/antares > #ProgressBar > renders progress bars in different sizes 1`] = `"<div class="box" style="display:flex;flex-direction:column;gap:var(--sp-md, 8px)"><div data-size="xs" data-status="default" class="box progressBar" style="display:flex;flex-direction:column;gap:var(--sp-xs, 2px)" data-rac="" id="react-aria-_R_1_" aria-labelledby="react-aria-_R_1H1_" aria-valuenow="40" aria-valuemin="0" aria-valuemax="100" aria-valuetext="40%" role="progressbar"><div class="box" style="display:flex;flex-direction:row;justify-content:space-between;align-items:baseline"><span class="label" id="react-aria-_R_1H1_">Extra Small</span><span class="text valueLabel">40%</span></div><div class="track" style="--progress-bar-progress:40%"></div></div><div data-size="sm" data-status="default" class="box progressBar" style="display:flex;flex-direction:column;gap:var(--sp-xs, 2px)" data-rac="" id="react-aria-_R_2_" aria-labelledby="react-aria-_R_2H1_" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100" aria-valuetext="60%" role="progressbar"><div class="box" style="display:flex;flex-direction:row;justify-content:space-between;align-items:baseline"><span class="label" id="react-aria-_R_2H1_">Small</span><span class="text valueLabel">60%</span></div><div class="track" style="--progress-bar-progress:60%"></div></div><div data-size="md" data-status="default" class="box progressBar" style="display:flex;flex-direction:column;gap:var(--sp-xs, 2px)" data-rac="" id="react-aria-_R_3_" aria-labelledby="react-aria-_R_3H1_" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100" aria-valuetext="80%" role="progressbar"><div class="box" style="display:flex;flex-direction:row;justify-content:space-between;align-items:baseline"><span class="label" id="react-aria-_R_3H1_">Medium</span><span class="text valueLabel">80%</span></div><div class="track" style="--progress-bar-progress:80%"></div></div></div>"`;

exports[`@godaddy/antares > #ProgressBar > renders progress bars with different statuses 1`] = `"<div class="box" style="display:flex;flex-direction:column;gap:var(--sp-md, 8px)"><div data-size="md" data-status="default" class="box progressBar" style="display:flex;flex-direction:column;gap:var(--sp-xs, 2px)" data-rac="" id="react-aria-_R_1_" aria-labelledby="react-aria-_R_1H1_" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100" aria-valuetext="50%" role="progressbar"><div class="box" style="display:flex;flex-direction:row;justify-content:space-between;align-items:baseline"><span class="label" id="react-aria-_R_1H1_">Default</span><span class="text valueLabel">50%</span></div><div class="track" style="--progress-bar-progress:50%"></div><span class="text helperText">In progress</span></div><div data-size="md" data-status="success" class="box progressBar" style="display:flex;flex-direction:column;gap:var(--sp-xs, 2px)" data-rac="" id="react-aria-_R_2_" aria-labelledby="react-aria-_R_2H1_" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" aria-valuetext="100%" role="progressbar"><div class="box" style="display:flex;flex-direction:row;justify-content:space-between;align-items:baseline"><span class="label" id="react-aria-_R_2H1_">Success</span><span class="text valueLabel">100%</span></div><div class="track" style="--progress-bar-progress:100%"></div><span class="text helperText">Complete</span></div><div data-size="md" data-status="warning" class="box progressBar" style="display:flex;flex-direction:column;gap:var(--sp-xs, 2px)" data-rac="" id="react-aria-_R_3_" aria-labelledby="react-aria-_R_3H1_" aria-valuenow="70" aria-valuemin="0" aria-valuemax="100" aria-valuetext="70%" role="progressbar"><div class="box" style="display:flex;flex-direction:row;justify-content:space-between;align-items:baseline"><span class="label" id="react-aria-_R_3H1_">Warning</span><span class="text valueLabel">70%</span></div><div class="track" style="--progress-bar-progress:70%"></div><span class="text helperText">Storage almost full</span></div><div data-size="md" data-status="critical" class="box progressBar" style="display:flex;flex-direction:column;gap:var(--sp-xs, 2px)" data-rac="" id="react-aria-_R_4_" aria-labelledby="react-aria-_R_4H1_" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100" aria-valuetext="30%" role="progressbar"><div class="box" style="display:flex;flex-direction:row;justify-content:space-between;align-items:baseline"><span class="label" id="react-aria-_R_4H1_">Critical</span><span class="text valueLabel">30%</span></div><div class="track" style="--progress-bar-progress:30%"></div><span class="text helperText">Action required</span></div></div>"`;

exports[`@godaddy/antares > #ProgressBar > renders the default progress bar 1`] = `"<div data-size="md" data-status="default" class="box progressBar" style="display:flex;flex-direction:column;gap:var(--sp-xs, 2px)" data-rac="" id="react-aria-_R_0_" aria-labelledby="react-aria-_R_0H1_" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100" aria-valuetext="60%" role="progressbar"><div class="box" style="display:flex;flex-direction:row;justify-content:space-between;align-items:baseline"><span class="label" id="react-aria-_R_0H1_">Loading…</span><span class="text valueLabel">60%</span></div><div class="track" style="--progress-bar-progress:60%"></div><span class="text helperText">Please wait while we process your request</span></div>"`;
